{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "@quenti/next#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "QUENTI_ENCRYPTION_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "METRICS_API_USER",
        "METRICS_API_PASSWORD",
        "RESEND_API_KEY",
        "EMAIL_SENDER",
        "GITHUB_MEDIA_TOKEN",
        "GITHUB_MEDIA_OWNER",
        "GITHUB_MEDIA_REPO",
        "BLOB_READ_WRITE_TOKEN",
        "SQL_WASM_PATH",
        "SERVER_NAME"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "inputs": ["**/*", "!apps/cdn/**"]
    },
    "start": {
      "outputs": ["dist/**", "build/**"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "passThroughEnv": ["ANALYZE"]
    },
    "dev": {
      "cache": false
    }
  },
  "globalDependencies": [
    "**/.env",
    "bun.lockb",
    "packages/console/**/*",
    "packages/integrations/**/*"
  ],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "VERCEL",
    "VERCEL_URL",
    "STRIPE_PRIVATE_KEY",
    "USERS_BUCKET_URL",
    "ASSETS_BUCKET_URL",
    "SKIP_ENV_VALIDATION",
    "ANALYZE",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WEBSITE_URL",
    "NEXT_PUBLIC_DEPLOYMENT",
    "NEXT_PUBLIC_HIGHLIGHT_PROJECT_ID",
    "NEXT_PUBLIC_BETTERUPTIME_ID",
    "NEXT_PUBLIC_STRIPE_PUBLIC_KEY",
    "NEXT_PUBLIC_CDN_WORKER_ENDPOINT",
    "NEXT_PUBLIC_CGI_ENDPOINT",
    "NEXT_PUBLIC_TELEMETRY_HOST",
    "NEXT_PUBLIC_TELEMETRY_KEY"
  ]
}
